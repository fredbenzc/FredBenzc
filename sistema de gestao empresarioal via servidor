//==================================================== CASE - 2 =========================================================================================================

void venda(int *total_produtos, int codigo[MAX], char nome_produto[MAX][30], float preco[MAX], int qt_estoque[MAX],float *saldo_caixa)
{
    system("cls");
    
    
    int cod_pesquisa, qt_venda,  achou = 0;
    float total_venda;
    
    printf("\t================ VENDAS ================\n");
    printf("\t* CODIGO DO PRODUTO -> ");	
    scanf("%d", &cod_pesquisa);	

    system("cls");
    
    
    for(int i = 1; i < *total_produtos; i++)
    {
        if(cod_pesquisa == codigo[i]) 
        {
            achou = 1; // Marca que o produto existe no sistema
            
            printf("\n\t======================= PRODUTO ENCONTRADO ===========================\n");
            printf("\t%-20s \t%-10s \t%-12s \t%-10s\n", "NOME DO PRODUTO", "CODIGO", "PRECO", "ESTOQUE ATUAL");     
            printf("\t======================================================================\n");
            printf("\t%-20s \t#%03d      \tR$ %-10.2f \t%d Un\n", nome_produto[i], codigo[i], preco[i], qt_estoque[i]);
            printf("\t----------------------------------------------------------------------\n");
            
            printf("\n\t* DIGITE A QUANTIDADE PARA VENDA -> ");   
            scanf("%d", &qt_venda);
            
            if(qt_venda <= qt_estoque[i]) // Valida se há estoque suficiente
            {
                qt_estoque[i] -= qt_venda; 
                total_venda = qt_venda * preco[i];
                *saldo_caixa += total_venda;
                
                printf("\n\t[SUCESSO] Venda realizada com sucesso!\n");
                printf("\tTOTAL A PAGAR: R$ %.2f\n\n\n\n\n", total_venda);
            }
            else
            {
                printf("\n\t[ERRO] Estoque insuficiente! Operacao cancelada.\n\n\n\n\n");
            }
            
            system("pause > nul"); 
            break;
        }
    }                     

    if(achou == 0) // Se o loop terminou e a variável 'achou' continuar em 0
    {
        printf("\n\t[AVISO] PRODUTO NAO ENCONTRADO NO SISTEMA!\n\n\n\n\n"); 
        system("pause");	
    }
}
