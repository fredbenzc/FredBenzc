//======================================================================= ping ===================================================================================================
void ping() 
{
    // Define o comando. No Windows, 'ping -n 1' envia apenas 1 pacote.
   
    char comando[100];
    
	sprintf(comando, "ping -n 1 %s > nul", IP_SERVIDOR);
    
    printf("\n\n\n\n\t\tVerificando conexao com o servidor [%s]...", IP_SERVIDOR);
    
    // Executa o comando. Se o servidor responder, o retorno é 0.
    int status = system(comando);
    
    printf("\n\t\t--------------------------------------------------\n");
    if (status == 0) 
    {
        printf("\n\t\t[ONLINE] O servidor esta respondendo normalmente!\n");
        printf("\t        Pode carregar ou salvar os arquivos com seguranca.\n");
    } 
    else 
    {
        printf("\n\t\t[OFFLINE] Erro! Nao foi possivel alcancar o servidor.\n");
        printf("\t        Verifique os cabos, o IP ou se o Samba esta rodando.\n");
    }
        
    system("pause > nul");
}

